#!/usr/bin/env bash
#
# theme-switch - switch the color theme of i3, i3bar, i3blocks, rofi and the keyhint conky
#
# usage: theme-switch [--next | --prev | --pick | --apply | --list | <theme-name>]
#   --next    switch to the next theme (alphabetical, wraps around)
#   --prev    switch to the previous theme
#   --pick    choose a theme with rofi
#   --apply   re-apply the current theme (e.g. after editing i3blocks.conf.in)
#   --list    print available theme names
#
# Themes live in ~/.config/i3/themes/<name>.theme (see plasma-whitesur.theme for the roles).
# Generated files: theme/current, theme/current.sh, theme/i3-colors.conf, i3blocks.conf,
#                  ~/.config/rofi/theme-colors.rasi

I3_DIR="$HOME/.config/i3"
THEMES_DIR="$I3_DIR/themes"
OUT_DIR="$I3_DIR/theme"
DEFAULT_THEME="plasma-whitesur"
ROLES=(BG SURFACE FG MUTED SEP ACCENT ACCENT_DIM ACCENT_FG OK WARN CRIT INFO LAUNCH_TERM LAUNCH_WEB LAUNCH_FILES)

mkdir -p "$OUT_DIR"

list_themes() {
    for f in "$THEMES_DIR"/*.theme; do basename "$f" .theme; done
}

current_theme() {
    local t
    t=$(cat "$OUT_DIR/current" 2>/dev/null)
    [[ -f "$THEMES_DIR/$t.theme" ]] && echo "$t" || echo "$DEFAULT_THEME"
}

# step through the theme list: $1 = +1 or -1
step_theme() {
    local themes cur i n
    mapfile -t themes < <(list_themes)
    cur=$(current_theme)
    n=${#themes[@]}
    for i in "${!themes[@]}"; do
        [[ "${themes[$i]}" == "$cur" ]] && { echo "${themes[$(( (i + $1 + n) % n ))]}"; return; }
    done
    echo "${themes[0]}"
}

pick_theme() {
    local cur
    cur=$(current_theme)
    list_themes | rofi -dmenu -i -p "Theme" -select "$cur" \
        -theme "$HOME/.config/rofi/rofikeyhint.rasi" -theme-str 'listview { lines: 8; }'
}

# "#rrggbb" -> "rgba ( r, g, b, A % )" for rofi
rgba() {
    printf 'rgba ( %d, %d, %d, %s %% )' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}" "${2:-100}"
}

# mix "#fg" "#bg" PCT -> "#rrggbb" that is PCT% fg over bg
mix() {
    local a=$1 b=$2 p=$3 out="#" i x y
    for i in 1 3 5; do
        x=$((16#${a:i:2})); y=$((16#${b:i:2}))
        out+=$(printf '%02x' $(( (x * p + y * (100 - p) + 50) / 100 )))
    done
    printf '%s' "$out"
}

apply_theme() {
    local name=$1 file="$THEMES_DIR/$1.theme" role sed_args=()
    [[ -f "$file" ]] || { notify-send -u critical "Theme" "Unknown theme: $name"; exit 1; }

    # shellcheck source=/dev/null
    source "$file"
    for role in "${ROLES[@]}"; do
        [[ -n "${!role}" ]] || { notify-send -u critical "Theme" "$name.theme is missing $role"; exit 1; }
        sed_args+=(-e "s/@${role}@/${!role}/g")
    done

    echo "$name" > "$OUT_DIR/current"

    # 1. shell variables for scripts (server_stats, panel block, keyhint)
    {
        echo "# GENERATED by scripts/theme-switch ($name) - do not edit"
        echo "THEME_NAME=\"$NAME\""
        for role in "${ROLES[@]}"; do echo "$role=\"${!role}\""; done
    } > "$OUT_DIR/current.sh"

    # 2a. i3 window colors (included from the i3 config)
    cat > "$OUT_DIR/i3-colors.conf" <<EOF
# GENERATED by scripts/theme-switch ($name) - do not edit, change themes/$name.theme instead

# class                 border  backgr. text    indicator child_border
EOF
    # Unfocused tab text is FG softened toward BG (not MUTED) so it stays easy to read.
    local soft_fg
    soft_fg=$(mix "$FG" "$BG" 80)
    {
        printf '%-23s %s %s %s %s   %s\n' client.focused          "$ACCENT"  "$ACCENT_DIM" "$ACCENT_FG" "$ACCENT"  "$ACCENT"
        printf '%-23s %s %s %s %s   %s\n' client.focused_inactive "$SURFACE" "$SURFACE"    "$FG"        "$SURFACE" "$SURFACE"
        printf '%-23s %s %s %s %s   %s\n' client.unfocused        "$SURFACE" "$BG"         "$soft_fg"   "$BG"      "$BG"
        printf '%-23s %s %s %s %s   %s\n' client.urgent           "$CRIT"    "$CRIT"       "$FG"        "$CRIT"    "$CRIT"
        printf '%-23s %s %s %s %s   %s\n' client.placeholder      "$SURFACE" "$BG"         "$soft_fg"   "$BG"      "$BG"
        printf '%-23s %s\n'               client.background       "$BG"
    } >> "$OUT_DIR/i3-colors.conf"

    # 2b. i3bar colors: rewritten in place between the marker lines of the bar's colors {} block
    #     (variables from an included file are not visible in the main config)
    local bar_colors
    bar_colors=$(cat <<EOF
		background         $BG
		statusline         $FG
		separator          $SEP
		#                  border  background text
		focused_workspace  $ACCENT_DIM $ACCENT_DIM    $ACCENT_FG
		inactive_workspace $BG $BG    $MUTED
		urgent_workspace   $CRIT $CRIT    $FG
		binding_mode       $WARN $WARN    $BG
EOF
)
    if grep -q '# >>> theme colors' "$I3_DIR/config"; then
        local tmp
        tmp=$(mktemp)
        BAR_COLORS="$bar_colors" awk '
            /# >>> theme colors/ { print; print ENVIRON["BAR_COLORS"]; skip = 1; next }
            /# <<< theme colors/ { skip = 0 }
            !skip
        ' "$I3_DIR/config" > "$tmp" && cat "$tmp" > "$I3_DIR/config"
        rm -f "$tmp"
    fi

    # 3. i3blocks.conf from the template
    {
        echo "# GENERATED by scripts/theme-switch from i3blocks.conf.in ($name)"
        echo "# DO NOT EDIT: edit i3blocks.conf.in, then run: ~/.config/i3/scripts/theme-switch --apply"
        echo
        sed "${sed_args[@]}" "$I3_DIR/i3blocks.conf.in"
    } > "$I3_DIR/i3blocks.conf"

    # 4. rofi colors (imported by ~/.config/rofi/config.rasi)
    cat > "$HOME/.config/rofi/theme-colors.rasi" <<EOF
/* GENERATED by ~/.config/i3/scripts/theme-switch ($name) - do not edit */
* {
    background:                  $(rgba "$BG" 92);
    foreground:                  $(rgba "$FG");
    normal-background:           $(rgba "$BG" 0);
    normal-foreground:           @foreground;
    alternate-normal-background: $(rgba "$BG" 0);
    alternate-normal-foreground: @foreground;
    selected-normal-background:  $(rgba "$ACCENT_DIM");
    selected-normal-foreground:  $(rgba "$ACCENT_FG");
    active-background:           $(rgba "$SURFACE" 40);
    active-foreground:           $(rgba "$ACCENT");
    alternate-active-background: $(rgba "$SURFACE" 40);
    alternate-active-foreground: @active-foreground;
    selected-active-background:  $(rgba "$ACCENT");
    selected-active-foreground:  $(rgba "$ACCENT_FG");
    urgent-background:           $(rgba "$BG" 0);
    urgent-foreground:           $(rgba "$CRIT");
    alternate-urgent-background: $(rgba "$BG" 0);
    alternate-urgent-foreground: @urgent-foreground;
    selected-urgent-background:  $(rgba "$CRIT");
    selected-urgent-foreground:  $(rgba "$FG");
    border-color:                $(rgba "$SEP");
    separatorcolor:              $(rgba "$SEP" 0);
}
EOF

    # 5. reload i3 (window colors), then restart the bars so i3blocks re-reads its config.
    #    A reload alone keeps the running i3bar/i3blocks, and i3 does not respawn killed bars,
    #    so they are relaunched here the same way i3 starts them.
    if i3-msg -q reload; then
        local sock bars
        sock=$(i3 --get-socketpath)
        mapfile -t bars < <(i3-msg -t get_bar_config | jq -r '.[]')
        kill $(pgrep -x i3bar) 2>/dev/null
        sleep 0.3
        for bar in "${bars[@]}"; do
            setsid i3bar --bar_id="$bar" --socket="$sock" >/dev/null 2>&1 < /dev/null &
        done
    fi

    # 6. keyhint conky follows the theme if it is open
    [[ -x "$I3_DIR/scripts/keyhint-toggle" ]] && "$I3_DIR/scripts/keyhint-toggle" --refresh

    notify-send -t 1500 -h string:x-canonical-private-synchronous:theme "Theme" "$NAME"
}

case "$1" in
    --next)  apply_theme "$(step_theme 1)" ;;
    --prev)  apply_theme "$(step_theme -1)" ;;
    --pick)  t=$(pick_theme); [[ -n "$t" ]] && apply_theme "$t" ;;
    --apply) apply_theme "$(current_theme)" ;;
    --list)  list_themes ;;
    "")      sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)       apply_theme "$1" ;;
esac
