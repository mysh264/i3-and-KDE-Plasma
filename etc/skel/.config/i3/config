#########################################

#########################################
#               Font                    #
#########################################

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
font pango:Noto Sans Regular 11, Font Awesome 7 Free Solid:style=Solid 11

#########################################

#########################################
#          Windows Managment            #
#########################################

# Workspace layout
workspace_layout tabbed

# Automatic back-and-forth when switching to the current workspace
## https://i3wm.org/docs/userguide.html#_automatic_back_and_forth_when_switching_to_the_current_workspace
workspace_auto_back_and_forth yes

########################################

##############################
# Extra options for windows  #
##############################

# border indicator on windows:
new_window pixel $pix

# Set inner/outer gaps
gaps inner 8
gaps outer 3

# This ensures that when a window is the only one,
# it effectively becomes "maximized" so Picom can see it
smart_borders on

# Enabling “Smart Gaps” means no gaps will be shown when there is
# precisely one window or split container on the workspace.
smart_gaps on

# Hiding borders adjacent to the screen edges
hide_edge_borders smart_no_gaps

# window title alignment
title_align center

# Use $mod+Mouse to drag floating windows to their wanted position
floating_modifier $mod

#########################################

#########################################
#          Workspace Shortcuts          #
#########################################

# Workspace
# switch/iterate between workspaces
$sym $mod+Tab workspace next
$sym $mod+Shift+Tab workspace prev

# switch between the current and the previously focused one
$sym Shift+space workspace back_and_forth

# open new empty workspace
$code $mod+Shift+$n $exec ~/.config/i3/scripts/empty_workspace

# switch to workspace
$code $mod+10    workspace  $ws1
$code $mod+11    workspace  $ws2
$code $mod+12    workspace  $ws3
$code $mod+13    workspace  $ws4
$code $mod+14    workspace  $ws5
$code $mod+15    workspace  $ws6
$code $mod+16    workspace  $ws7
$code $mod+17    workspace  $ws8
$code $mod+18    workspace  $ws9
$code $mod+19    workspace  $ws10
$code $mod+20    workspace  $ws11
$code $mod+21    workspace  $ws12

# move focused container to workspace
$code $mod+Shift+10    move container to workspace  $ws1
$code $mod+Shift+11    move container to workspace  $ws2
$code $mod+Shift+12    move container to workspace  $ws3
$code $mod+Shift+13    move container to workspace  $ws4
$code $mod+Shift+14    move container to workspace  $ws5
$code $mod+Shift+15    move container to workspace  $ws6
$code $mod+Shift+16    move container to workspace  $ws7
$code $mod+Shift+17    move container to workspace  $ws8
$code $mod+Shift+18    move container to workspace  $ws9
$code $mod+Shift+19    move container to workspace  $ws10
$code $mod+Shift+20    move container to workspace  $ws11
$code $mod+Shift+21    move container to workspace  $ws12

# Workspace by mouse
$sym Mod1+space workspace $ws10

#########################################

#########################################
#          Windows Shortcuts            #
#########################################

# kill focused window
$code $mod+$q kill

# kill window by mouse "Mod4+Right click"
$sym --whole-window $mod+button3 kill
#$sym --whole-window $mod+button3 workspace back_and_forth

# Kill application shortcuts
$code $mod+$x [class="mpv"] kill
$code $mod+Shift+$x $exec "killall $img1 ; killall $img2"
$code Mod1+$x $exec killall $file1

# change focus, you can use the cursor keys:
$sym $mod+Left focus left
$sym $mod+Down focus down
$sym $mod+Up focus up
$sym $mod+Right focus right

# move focused window, you can use the cursor keys:
$sym $mod+Shift+Left move left
$sym $mod+Shift+Down move down
$sym $mod+Shift+Up move up
$sym $mod+Shift+Right move right

# split in horizontal orientation
$code $mod+$h split h

# split in vertical orientation
$code $mod+$v split v

# enter fullscreen mode for the focused container
$code $mod+$f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
# https://i3wm.org/docs/userguide.html#manipulating_layout
$code $mod+$s layout stacking
$code $mod+$w layout toggle tabbed split
$code $mod+$e layout toggle split

# toggle tiling / floating
$code $mod+$z floating toggle

# change focus between tiling / floating windows
#$sym $mod+space focus mode_toggle

# focus the parent container
$code $mod+$a focus parent

#########################################

#########################################
#        Applications Shortcuts         #
#########################################

# Applications
# Start a terminal
$sym $mod+Return $exec $term1
$sym $mod+Shift+Return $exec $term2
$sym XF86Favorites $exec $drop

# Web Browser
$code $mod+$j $exec $browser1
$code $mod+Shift+$j $exec $browser2

# File Manager
$code $mod+$n $exec $file1

#########################################

#########################################
#           System Shortcuts            #
#########################################

# exit-menu
$code $mod+Shift+$e $exec ~/.config/i3/scripts/powermenu

# reload the configuration file
$code $mod+Shift+$c reload

# restart i3 inplace (preserves your layout/session, can be used to update i3)
$code $mod+Shift+$r restart

#########################################

#########################################
#             Other Shortcuts           #
#########################################

# Toggle plasma panel
$code $mod+$u $exec ~/.config/i3/scripts2/'KDE Plasma'/plasma_panel/panel_toggle.sh && pkill -RTMIN+2 i3blocks

# Toggle plasma panel (Dock Mode)
$code $mod+Shift+$u $exec ~/.config/i3/scripts2/'KDE Plasma'/plasma_panel/panel_dock_toggle.sh && pkill -RTMIN+2 i3blocks

# Press Mod+Shift+p to rescue/restart the Plasma Panel
bindsym $mod+Shift+p exec --no-startup-id ~/.config/i3/scripts2/'KDE Plasma'/plasma_panel/panel_restart.sh && pkill -RTMIN+2 i3blocks

