# Resize window (you can also use the mouse for that):

mode "resize" {
# These bindings trigger as soon as you enter the resize mode
# Pressing left will shrink the window's width.
# Pressing right will grow the window's width.
# Pressing up will shrink the window's height.
# Pressing down will grow the window's height.
        $sym Left resize shrink width 10 px or 10 ppt
        $sym Down resize grow height 10 px or 10 ppt
        $sym Up resize shrink height 10 px or 10 ppt
        $sym Right resize grow width 10 px or 10 ppt

# back to normal: Enter or Escape or Space or Mod4+r
        $sym Return mode "default"
        $sym Escape mode "default"
        $code $mod+$r mode "default"
        $sym space mode "default"
}

$sym $mod+r mode "resize"

