#########################################
#           Floating rules              #
#########################################

# set border of floating window
for_window [class="urxvt"] border pixel 1

# set size of floating window
#for_window [window_role="(?i)GtkFileChooserDialog"] resize set 640 480 #to set size of file choose dialog
#for_window [class=".*"] resize set 640 480 #to change size of all floating windows

# set position of floating window
#for_window [class=".*"] move position center

for_window [class="Yad"] floating enable

# Plasma compatibility improvements
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
#for_window [class="yakuake"] floating enable
#for_window [class="systemsettings"] floating enable
for_window [class="plasmashell"] floating enable
for_window [class="Plasma"] floating enable, border none
for_window [title="plasma-desktop"] floating enable, border none
for_window [title="win7"] floating enable, border none
for_window [class="krunner"] floating enable, border none
for_window [class="Kmix"] floating enable, border none
for_window [class="Klipper"] floating enable, border none
for_window [class="Plasmoidviewer"] floating enable, border none
for_window [class="(?i)*nextcloud*"] floating disable

no_focus [class="plasmashell" window_type="notification"]

# Killing the existing window that covers everything
for_window [title="^Desktop @ QRect.*"] kill, floating enable, border none

# 1. Strip the dock behavior and force it into the floating layer
for_window [class="plasmashell" title="Togglehidepanelplasma"] floating enable, border none, sticky enable

# 2. Prevent it from stealing focus when it appears
no_focus [class="plasmashell" title="Togglehidepanelplasma"]

# 3. Position it at the absolute top (0,0) without reserving space
for_window [class="plasmashell" title="Togglehidepanelplasma"] move absolute position 0 0

