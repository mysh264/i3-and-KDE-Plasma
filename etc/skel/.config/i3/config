#########################################
#             Environments              #
#########################################

# Generals
# Mod4 is the super key and Mod1 is alt key
	set $mod Mod4
	set $alt Mod1

# Exec
	 set $exalways exec_always --no-startup-id
	 set $exec exec --no-startup-id

# Bind
	set $sym bindsym
	set $code bindcode

	set $sre bindsym --release
	set $cre bindcode --release

# Home
	set $HOME ~

#########################################
# Applicatons
# Internet Browser
	set $browser1 brave
	set $browser2 firefox
	set $browser3 chromium

# File Manager
	set $file1 dolphin

# Image Viewer
	set $img1 viewnior
	set $img2 gwenview

# Terminal 
	set $term1 konsole
	set $term2 kitty
	set $drop xfce4-terminal --drop-down

# Mail
	set $mail thunderbird

#########################################
# Wallpaper
# Feh Options
	#set $feh feh --bg-scale

	set $feh $HOME/.config/i3/scripts2/fehbg.sh -t 300  # -t means sleep time

#########################################
# Border
set $pix 0

#########################################
