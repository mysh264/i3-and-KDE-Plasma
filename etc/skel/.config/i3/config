set $e 26

set $f 41

set $g 42

set $h 43

set $i 31

set $j 44

set $k 45

set $l 46

set $m 58

set $n 57

set $o 32

set $p 33

set $q 24

set $r 27

set $s 39

set $t 28

set $u 30

set $v 55

set $w 25

set $x 53

